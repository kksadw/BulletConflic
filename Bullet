local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Window = Rayfield:CreateWindow({
    Name = "Mop Shop Admin",
    LoadingTitle = "Mop Shop",
    LoadingSubtitle = "Admin Panel",
    ConfigurationSaving = {
        Enabled = false
    }
})

--========================--
--      COMPRAR
--========================--

local ShopTab = Window:CreateTab("🛒 Comprar", 4483362458)

local Cantidad = 1

ShopTab:CreateInput({
    Name = "Cantidad",
    PlaceholderText = "Ej: 10",
    RemoveTextAfterFocusLost = false,
    Callback = function(Text)
        local Num = tonumber(Text)
        if Num and Num > 0 then
            Cantidad = math.floor(Num)
        end
    end
})

ShopTab:CreateButton({
    Name = "🛒 Comprar WormtecRegular",
    Callback = function()
        local args = {
            "BUY",
            "WormtecRegular",
            Cantidad
        }

        game:GetService("ReplicatedStorage")
            :WaitForChild("MopShopEvent")
            :FireServer(unpack(args))

        Rayfield:Notify({
            Title = "Compra",
            Content = "Compraste "..Cantidad.." WormtecRegular.",
            Duration = 3,
            Image = 4483362458
        })
    end
})

ShopTab:CreateButton({
    Name = "💰 Vender Todo",
    Callback = function()
        game:GetService("ReplicatedStorage")
            :WaitForChild("SellShopEvent")
            :FireServer("SELL_ALL")

        Rayfield:Notify({
            Title = "Venta",
            Content = "Se vendieron todos los objetos.",
            Duration = 3,
            Image = 4483362458
        })
    end
})

